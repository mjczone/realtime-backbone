{
  "name": "@mjczone/realtime-agui-server",
  "version": "0.0.0",
  "description": "Publish an AG-UI agent run (Mastra or any AG-UI agent) to the realtime backbone, plus run endpoint helpers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mjczone/realtime-backbone.git",
    "directory": "ts/agui-server"
  },
  "homepage": "https://github.com/mjczone/realtime-backbone#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mjczone/realtime-contract": "workspace:*",
    "@mjczone/realtime-publisher": "workspace:*",
    "@mjczone/realtime-tokens": "workspace:*"
  },
  "peerDependencies": {
    "@ag-ui/client": "^1.0.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@ag-ui/client": "1.0.2",
    "@ag-ui/mastra": "1.1.6",
    "@mastra/core": "1.75.0",
    "ai": "7.0.137",
    "rxjs": "7.8.1",
    "zod": "^4.1.12"
  }
}
