{
  "http_server": {
    "port": 8000,
    "internal_port": 9000
  },
  "log": {
    "level": "info"
  },
  "engine": {
    "type": "redis",
    "redis": {
      "address": [
        "redis://valkey:6379"
      ]
    }
  },
  "http_api": {
    "key": ""
  },
  "grpc_api": {
    "enabled": true,
    "port": 10000,
    "key": ""
  },
  "health": {
    "enabled": true
  },
  "prometheus": {
    "enabled": true
  },
  "usage_stats": {
    "disabled": true
  },
  "client": {
    "allowed_origins": [],
    "recovery_max_publication_limit": 2000,
    "queue_max_size": 16777216,
    "token": {
      "jwks_public_endpoint": "",
      "audience": "",
      "issuer": ""
    },
    "subscription_token": {
      "enabled": true,
      "jwks_public_endpoint": "",
      "audience": "",
      "issuer": ""
    }
  },
  "channel": {
    "publication_data_format": "json_object",
    "namespaces": [
      {
        "name": "live",
        "allow_user_limited_channels": true,
        "channel_regex": "^(global\\.[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)?|t-[A-Za-z0-9_-]{1,64}\\.([A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)?|user#[A-Za-z0-9_-]{1,128}))$"
      },
      {
        "name": "replay",
        "allow_user_limited_channels": true,
        "history_size": 2000,
        "history_ttl": "600s",
        "history_meta_ttl": "1800s",
        "force_recovery": true,
        "channel_regex": "^(global\\.[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)?|t-[A-Za-z0-9_-]{1,64}\\.([A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)?|user#[A-Za-z0-9_-]{1,128}))$"
      },
      {
        "name": "presence",
        "presence": true,
        "join_leave": true,
        "force_push_join_leave": true,
        "allow_presence_for_subscriber": true,
        "channel_regex": "^t-[A-Za-z0-9_-]{1,64}\\.[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)?$"
      }
    ]
  },
  "sse": {
    "enabled": true
  },
  "http_stream": {
    "enabled": true
  }
}
