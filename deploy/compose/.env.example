# Copy to .env (gitignored) and fill in. Generate secrets with: openssl rand -hex 32

# Bundled Valkey. Remove "valkey" to use a managed Valkey or Redis at VALKEY_ADDRESS instead.
# Add "tls" to put Caddy with automatic HTTPS for DOMAIN in front of the client port.
# Add "gateway" for realtime-gateway (see README.md): then JWKS_URL=http://gateway:8090/.well-known/rtb-jwks.json.
COMPOSE_PROFILES=valkey

BACKBONE_IMAGE=ghcr.io/mjczone/realtime-backbone:0.3.0
# warn: log problems and start anyway. strict: refuse to start on a failure. off: skip.
RTB_DOCTOR=warn

API_KEY=
GRPC_API_KEY=

VALKEY_PASSWORD=
VALKEY_MAXMEMORY=512mb
# For a managed Valkey, for example rediss://default:PASSWORD@host:25061 (then leave VALKEY_PASSWORD empty).
VALKEY_ADDRESS=redis://valkey:6379

# Origins of the web apps that connect, space separated.
ALLOWED_ORIGINS=https://app.example.com
# Your app serves its public keys here (the token SDKs expose /.well-known/rtb-jwks.json).
JWKS_URL=https://app.example.com/.well-known/rtb-jwks.json
TOKEN_AUDIENCE=realtime-backbone
TOKEN_ISSUER=app.example.com
# Only if subscription tokens come from somewhere else than connection tokens (for example, an IdP mints connection tokens).
# SUBSCRIPTION_JWKS_URL=
# SUBSCRIPTION_TOKEN_AUDIENCE=
# SUBSCRIPTION_TOKEN_ISSUER=

DATA_DIR=./data
CLIENT_BIND=0.0.0.0
CLIENT_PORT=8000
# Keep the API off the public interface. Set a private interface address to reach it from other hosts.
API_BIND=127.0.0.1
API_PORT=9000
GRPC_PORT=10000

# With the gateway profile. gateway.json can use any variable from this file as ${NAME}.
GATEWAY_IMAGE=ghcr.io/mjczone/realtime-backbone-gateway:0.3.0
GATEWAY_PORT=8090

# With the tls profile.
DOMAIN=rt.example.com
