{
  "name": "realtime-backbone",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./ts/*\" build",
    "test": "pnpm -r --filter \"./ts/*\" test",
    "test:integration": "pnpm --filter @mjczone/realtime-integration test:integration",
    "dev:up": "docker compose up -d --build --wait && docker compose port demo 8080",
    "dev:down": "docker compose --profile samples --profile signals down",
    "dev:purge": "node scripts/dev-purge.mjs",
    "dev:logs": "docker compose logs -f",
    "dev:doctor": "docker compose exec backbone realtime-doctor",
    "samples:up": "docker compose --profile samples up -d --build --wait && node scripts/samples-urls.mjs",
    "samples:logs": "docker compose --profile samples logs -f",
    "samples:signals": "docker compose --profile signals run --rm --build py-signals",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
