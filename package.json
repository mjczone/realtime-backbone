{
  "name": "realtime-backbone",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./ts/*\" build",
    "test": "pnpm -r --filter \"./ts/*\" test",
    "dev:up": "docker compose up -d --build --wait && echo Test page: http://localhost:8080",
    "dev:down": "docker compose down",
    "dev:purge": "node scripts/dev-purge.mjs",
    "dev:logs": "docker compose logs -f",
    "dev:doctor": "docker compose exec backbone rtb-doctor"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
